{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/crm",
      "destination": "/kalkulator/crm",
      "permanent": false
    },
    {
      "source": "/crm/",
      "destination": "/kalkulator/crm",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/kalkulator",
      "destination": "https://tadex-kalkulator.vercel.app/kalkulator"
    },
    {
      "source": "/kalkulator/",
      "destination": "https://tadex-kalkulator.vercel.app/kalkulator/"
    },
    {
      "source": "/kalkulator/:path+",
      "destination": "https://tadex-kalkulator.vercel.app/kalkulator/:path+"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
