{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/crm",
      "destination": "/kalkulator/crm",
      "permanent": false
    },
    {
      "source": "/crm/",
      "destination": "/kalkulator/crm",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/auth/confirm",
      "destination": "/auth/confirm/index.html"
    },
    {
      "source": "/sb/:path*",
      "destination": "https://ichcxptnnzakwzlmixvk.supabase.co/:path*"
    },
    {
      "source": "/kalkulator",
      "destination": "https://tadex-kalkulator.vercel.app/kalkulator"
    },
    {
      "source": "/kalkulator/",
      "destination": "https://tadex-kalkulator.vercel.app/kalkulator/"
    },
    {
      "source": "/kalkulator/:path+",
      "destination": "https://tadex-kalkulator.vercel.app/kalkulator/:path+"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/auth/confirm(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
